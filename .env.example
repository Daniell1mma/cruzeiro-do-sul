# =====================================================================
# Fraternidade Cruzeiro do Sul - Variáveis de Ambiente
# =====================================================================

# Ambiente de execução: development | production
NODE_ENV=development

# Porta do servidor da API (e do servidor unificado em produção)
PORT=5000

# Porta do Vite (apenas em desenvolvimento para o frontend isolado)
VITE_PORT=5173

# Caminho base da aplicação web (padrão "/")
BASE_PATH=/

# Segredo para assinatura de cookies de sessão (express-session)
# Gere uma chave aleatória e segura em produção
SESSION_SECRET=dev-cruzeiro-secret-session-key-change-in-production-2026

# String de conexão com o banco de dados PostgreSQL
# Exemplos gratuitos: Supabase, Neon.tech, Render PostgreSQL ou Postgres local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cruzeiro_do_sul

# (Opcional) URL base da API se o frontend for hospedado separadamente
# VITE_API_BASE_URL=https://sua-api.onrender.com
